# Copy to .env and fill in. Never commit .env (it is in .gitignore).

# LocalAI chat completions endpoint
LOCALAI_URL=http://<localai-host>:8080/v1/chat/completions
LOCALAI_MODEL=Qwen2.5-7B-Instruct-Q4_K_M.gguf

# Shared secret callers must send in the X-API-Token header.
# Generate with: openssl rand -hex 32
TRIAGE_API_TOKEN=<generate-a-random-64-char-hex-value>

# Decoy token. Plant it somewhere an intruder would look (for example a
# fake "backup" config file), never give it to a real caller.
# Generate with: openssl rand -hex 32
TRIAGE_HONEYTOKEN=<generate-a-different-random-value>

# Guardrail tuning
ALWAYS_TICKET_LEVEL=10
MIN_FP_CONFIDENCE=80

# Set to 1 to start in safe mode (LLM bypassed, every alert ticketed)
TRIAGE_SAFE_MODE=0
