{
  "name": "RAG - Question Answering",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ask-question",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "3c333333-3333-4333-8333-333333333301",
      "name": "Question Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-1180, 300],
      "webhookId": "ask-question"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// n8n webhooks sometimes nest the payload under .body -- handle both.\nconst raw = items[0].json;\nconst input = raw.body ? raw.body : raw;\n\nconst question = input.question;\nif (!question) {\n  throw new Error('Expected { question } in the request body. Got: ' + JSON.stringify(raw));\n}\n\nreturn [{ json: { question } }];"
      },
      "id": "3c333333-3333-4333-8333-333333333302",
      "name": "Extract Question",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-960, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://${LOCALAI_HOST}:8080/v1/embeddings",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'all-MiniLM-L6-v2-Q4_0.gguf', input: $json.question }) }}",
        "options": {}
      },
      "id": "3c333333-3333-4333-8333-333333333303",
      "name": "Embed Question",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-740, 300]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Build the similarity-search query.\n// pgvector's <=> operator returns cosine DISTANCE (0 = identical,\n// higher = less similar), so ORDER BY it ascending gets closest matches first.\n\nconst embeddingArray = item.json.data[0].embedding;\nconst embeddingStr = '[' + embeddingArray.join(',') + ']';\n\nconst sql = \"SELECT source_name, chunk_text, embedding <=> '\" + embeddingStr +\n  \"'::vector AS distance FROM documents ORDER BY distance ASC LIMIT 5\";\n\nreturn { json: { sql, question: $('Extract Question').item.json.question } };"
      },
      "id": "3c333333-3333-4333-8333-333333333304",
      "name": "Build Search Query",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-520, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "={{ $json.sql }}",
        "options": {}
      },
      "id": "3c333333-3333-4333-8333-333333333305",
      "name": "Search pgvector",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [-300, 300],
      "credentials": {
        "postgres": {
          "id": "PLACEHOLDER_SET_AFTER_IMPORT",
          "name": "pgvector"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Combine the retrieved chunks into a single context block for the LLM.\n// If nothing was found (empty documents table, or no close match),\n// fall back to a clear \"no context\" marker rather than sending an empty prompt.\n\nconst rows = items.map((i) => i.json);\nconst question = $('Build Search Query').first().json.question;\n\nlet context;\nif (rows.length === 0) {\n  context = '(no relevant documents found)';\n} else {\n  context = rows\n    .map((r, idx) => `[${idx + 1}] (source: ${r.source_name}) ${r.chunk_text}`)\n    .join('\\n\\n');\n}\n\nconst systemPrompt =\n  'You are a helpful assistant answering questions using ONLY the provided ' +\n  'context below. If the context does not contain the answer, say you ' +\n  \"don't have enough information rather than guessing.\\n\\nContext:\\n\" + context;\n\nconst payload = {\n  model: 'Qwen2.5-7B-Instruct-Q4_K_M.gguf',\n  messages: [\n    { role: 'system', content: systemPrompt },\n    { role: 'user', content: question }\n  ]\n};\n\nreturn [{ json: { payload, sources: rows.map((r) => r.source_name) } }];"
      },
      "id": "3c333333-3333-4333-8333-333333333306",
      "name": "Build Answer Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-80, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://${LOCALAI_HOST}:8080/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.payload) }}",
        "options": {}
      },
      "id": "3c333333-3333-4333-8333-333333333307",
      "name": "Generate Answer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [140, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { answer: $json.choices[0].message.content, sources: $('Build Answer Prompt').item.json.sources } }}",
        "options": {}
      },
      "id": "3c333333-3333-4333-8333-333333333308",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.2,
      "position": [360, 300]
    }
  ],
