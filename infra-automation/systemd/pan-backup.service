[Unit]
Description=Palo Alto read-only config backup (encrypted) + change detection
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=infraops
Group=infraops
ExecStart=/home/infraops/infra/tools/pan-backup-auto.sh
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/home/infraops/infra /home/infraops/.ansible /dev/shm
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
TimeoutStartSec=20min
